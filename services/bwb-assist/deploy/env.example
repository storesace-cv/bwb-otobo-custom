# Bind only on localhost; nginx or SSH tunnel from OTOBO 132.
BWB_ASSIST_HOST=127.0.0.1
BWB_ASSIST_PORT=18100
BWB_ASSIST_BEARER=
# Comma-separated source IPs allowed when behind nginx (X-Forwarded-For / real IP).
# Empty = rely on network firewall only (service still requires Bearer).
BWB_ASSIST_ALLOWED_IPS=178.159.34.132

# Ollama (optional). Leave disabled on hosts with <8 GiB RAM.
BWB_ASSIST_OLLAMA_URL=http://127.0.0.1:11434
BWB_ASSIST_OLLAMA_MODEL=qwen2.5:7b-instruct
BWB_ASSIST_OLLAMA_ENABLED=0

# Index storage
BWB_ASSIST_DATA_DIR=/var/lib/bwb-assist

# OTOBO index API (FAQ + tickets RO) — filled on the server only
OTOBO_ASSIST_INDEX_URL=https://helpdesk.storesace.cv/otobo/public.pl
OTOBO_ASSIST_INDEX_TOKEN=

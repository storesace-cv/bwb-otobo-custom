# Copiar para .env local (NUNCA commitar). Ver .gitignore.

# pCloud — snapshot de configuração Ubuntu/OTOBO (auditoria)
PCLOUD_USERNAME=
PCLOUD_PASSWORD=

# Euronodes S3 — dumps MariaDB helpdesk (bucket único BWB)
EURONODES_S3_ACCESS_KEY=
EURONODES_S3_SECRET_KEY=
EURONODES_S3_BUCKET=bwb-backups
EURONODES_S3_PATH=helpdesk

# Opcional: SMTP alertas (smtp2go); se omitido, setup tenta GOTRUE_SMTP_* de my-bwb-app/.env
# BWB_HELPDESK_BACKUP_ALERT_EMAIL=jorge.peixinho@bwb.pt
# BWB_HELPDESK_S3_ALERT_SIZE_GB=800

# Cópias de segurança helpdesk (servidor Euronodes bwb-otobo-prod).
# Copiar para .env local — NUNCA commitar. Modelo: ../.env.example

# --- Euronodes S3: dumps MariaDB ---
BWB_HELPDESK_S3_DB_ENABLED=1
BWB_HELPDESK_S3_RCLONE_REMOTE=euronodes-s3
BWB_HELPDESK_S3_BUCKET=bwb-backups
BWB_HELPDESK_S3_PATH=helpdesk
BWB_HELPDESK_S3_RETENTION_DAYS=8
BWB_HELPDESK_S3_ALERT_SIZE_GB=800

# --- pCloud: snapshot configs Ubuntu/OTOBO (auditoria) ---
BWB_HELPDESK_CONFIG_BACKUP_ENABLED=1
BWB_HELPDESK_PCLOUD_RCLONE_REMOTE=bwb-pcloud-helpdesk
BWB_HELPDESK_PCLOUD_CONFIG_PATH=backups/helpdesk-config
BWB_HELPDESK_CONFIG_RETENTION_DAYS=30

# --- Comum ---
BWB_HELPDESK_BACKUP_TARGET_LABEL=helpdesk
BWB_HELPDESK_BACKUP_DB_NAME=otobo
BWB_HELPDESK_BACKUP_ALERT_EMAIL=jorge.peixinho@bwb.pt

# Credenciais: ver .env.example (EURONODES_S3_*, PCLOUD_*) — gravadas pelo setup no servidor.

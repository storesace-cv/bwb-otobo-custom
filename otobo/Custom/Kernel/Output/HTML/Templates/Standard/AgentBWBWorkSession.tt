<style>
.BWBWorkSheet{max-width:1180px;margin:28px auto;padding:0 20px}.BWBWorkSheet .SheetHeader{background:#eef0f3;border-radius:16px;padding:22px 28px;margin-bottom:18px}.BWBWorkSheet .SheetHeader h1{font-size:26px;margin:0 0 7px}.BWBWorkSheet .ClientName{font-size:18px;font-weight:700}.BWBWorkSheet .TicketRef{color:#626976;margin-top:5px}.BWBWorkSheet .WorkCard{background:rgba(255,255,255,.93);border-radius:16px;padding:26px 30px;box-shadow:0 2px 8px rgba(0,0,0,.12)}.BWBWorkSheet label{font-size:16px;font-weight:700}.BWBWorkSheet select{font-size:16px;min-height:40px}.BWBWorkSheet .ProtectedText{background:#eef0f3;border-left:4px solid #444950;border-radius:6px;padding:18px 22px;margin:0 0 24px;font-size:16px;line-height:1.65;font-weight:700}.BWBWorkSheet .RichTextField{width:100%;margin:8px 0 18px}.BWBWorkSheet textarea#RichText{display:none}.BWBEditor{width:100%;border:1px solid #b8bec8;border-radius:8px;overflow:hidden;background:#fff;box-sizing:border-box}.BWBEditorToolbar{display:flex;gap:5px;padding:8px 10px;background:#eef0f3;border-bottom:1px solid #cfd3da;flex-wrap:wrap}.BWBEditorToolbar button{width:38px;height:34px;border:1px solid #b8bec8;border-radius:5px;background:#fff;color:#111;font-size:16px;cursor:pointer}.BWBEditorToolbar button:hover,.BWBEditorToolbar button:focus{background:#dfe3e8}.BWBEditorBody{width:100%;min-height:300px;padding:16px;font-size:16px;line-height:1.5;outline:none;box-sizing:border-box;overflow-wrap:anywhere}.BWBEditorBody ul,.BWBEditorBody ol{margin:8px 0 8px 24px}.BWBWorkSheet .VisibilityChoice{background:#f5f6f7;border-radius:10px;padding:15px 18px;margin:18px 0}.BWBWorkSheet .VisibilityChoice label{margin-right:26px}.BWBWorkSheet .Actions{display:flex;gap:10px;align-items:center;margin-top:22px;flex-wrap:wrap}.BWBWorkSheet .SaveStatus{color:#667085;margin:6px 0 0}.BWBWorkSheet .ErrorBox{background:#ffd7d2;color:#7b1710;border-radius:8px;padding:12px 16px;margin-bottom:18px}.BWBWorkSheet .Paused{background:#fff1c7;color:#6f4d00;border-radius:8px;padding:12px 16px;margin-bottom:16px}.BWBWorkSheet .FinishFields{border-top:1px solid #ddd;margin-top:20px;padding-top:18px}.BWBWorkSheet .FinishFields>div{margin:12px 0}.BWBWorkSheet .FinishFields label{display:inline-block;width:210px;vertical-align:top}.BWBWorkSheet .FinishFields select,.BWBWorkSheet .FinishFields input{width:min(520px,70%)}.BWBWorkSheet .Field,.BWBWorkSheet .AttachmentListContainer{max-width:none;width:100%;box-sizing:border-box}
.BWBWorkSheet .SheetHeader h1{margin-bottom:18px}.BWBWorkSheet .HeaderTicket{font-size:18px;font-weight:750}.BWBWorkSheet .HeaderCustomer{font-size:17px;font-weight:700;margin-top:5px}.BWBWorkSheet .HeaderCustomerUser{font-size:16px;margin-top:5px}.BWBWorkSheet .HeaderTitle{color:#626976;font-size:16px;line-height:1.45;margin-top:7px}.BWBWorkSheet .WorkSummary{display:grid;grid-template-columns:1fr;gap:18px;text-align:center}.BWBWorkSheet .WorkSummaryItem{display:flex;flex-direction:column;gap:5px}.BWBWorkSheet .WorkSummaryLabel{font-size:16px;font-weight:700;text-align:left}.BWBWorkSheet .WorkSummaryValue{font-size:17px;font-weight:700;text-align:center}.BWBWorkSheet .Actions .CancelAction{background:#c62828!important;border-color:#c62828!important;color:#fff!important}.BWBWorkSheet .Actions .PauseAction{background:#e67e22!important;border-color:#e67e22!important;color:#fff!important}.BWBWorkSheet .Actions .FinishAction{background:#18864b!important;border-color:#18864b!important;color:#fff!important}
@media(max-width:700px){.BWBWorkSheet{margin:12px auto;padding:0 10px}.BWBWorkSheet .SheetHeader{padding:17px 18px;border-radius:12px}.BWBWorkSheet .SheetHeader h1{font-size:22px}.BWBWorkSheet .ClientName{font-size:17px}.BWBWorkSheet .TicketRef{line-height:1.4}.BWBWorkSheet .WorkCard{padding:18px 14px;border-radius:12px}.BWBWorkSheet .ProtectedText{padding:15px 16px;font-size:16px;line-height:1.65}.BWBEditorBody{min-height:240px;padding:13px;font-size:16px}.BWBEditorToolbar button{width:48px;height:48px}.BWBWorkSheet .FinishFields label{display:block;width:auto;margin-bottom:7px}.BWBWorkSheet .FinishFields select,.BWBWorkSheet .FinishFields input,.BWBWorkSheet select{width:100%!important;max-width:100%;box-sizing:border-box;min-height:48px;font-size:16px}.BWBWorkSheet .VisibilityChoice label{display:inline-flex;align-items:center;gap:10px;margin:10px 22px 0 0;min-height:48px;font-size:16px}.BWBWorkSheet .VisibilityChoice input{width:22px;height:22px}.BWBWorkSheet .Actions{display:grid;grid-template-columns:1fr;gap:9px}.BWBWorkSheet .Actions button{width:100%;min-height:48px;font-size:16px}.BWBWorkSheet .AttachmentList{font-size:14px}.BWBWorkSheet .oooDnD{min-height:72px}}

/* Touch-friendly controls for tablets and other coarse-pointer devices. */
@media (hover:none) and (pointer:coarse), (max-width:1024px){
.BWBWorkSheet select,.BWBWorkSheet input[type="text"]{min-height:48px;font-size:16px;box-sizing:border-box}
.BWBEditorToolbar button{width:48px;height:48px;font-size:18px}
.BWBWorkSheet .Actions button{min-height:48px;padding:10px 16px;font-size:16px}
.BWBWorkSheet .ProtectedText{font-size:16px;line-height:1.65}
.BWBWorkSheet .VisibilityChoice{padding:14px 16px}.BWBWorkSheet .VisibilityChoice br{display:none}.BWBWorkSheet .VisibilityChoice strong{display:block;margin-bottom:10px}.BWBWorkSheet .VisibilityChoice label{float:none!important;display:inline-flex!important;width:calc(50% - 7px)!important;max-width:140px;min-height:52px;margin:0 8px 0 0!important;padding:0 14px!important;border:1px solid #c8cdd5;border-radius:10px;background:#fff;align-items:center;justify-content:flex-start;gap:10px;font-size:16px;line-height:1.2;box-sizing:border-box;text-align:left!important}.BWBWorkSheet .VisibilityChoice label:has(input:checked){border:2px solid #11158f;background:#eef0ff;font-weight:700}.BWBWorkSheet .VisibilityChoice input[type="radio"]{float:none!important;position:static!important;width:22px!important;height:22px!important;min-width:22px;margin:0!important;padding:0!important}.BWBWorkSheet input[type="datetime-local"]{min-height:48px;width:100%!important;font-size:16px;box-sizing:border-box}
.BWBTactileSelect{width:100%;min-height:52px;padding:10px 44px 10px 14px;border:1px solid #8d94a3;border-radius:10px;background:#fff;box-sizing:border-box;color:#080d45;font-family:inherit;font-size:16px;font-weight:600;line-height:1.35;text-align:left;position:relative}.BWBTactileSelect:after{content:'⌄';position:absolute;right:16px;top:50%;transform:translateY(-55%);font-size:24px}.BWBTactileSelect.Placeholder{color:#626976;font-weight:500}.BWBTactileOverlay{position:fixed;inset:0;z-index:100000;background:rgba(0,0,0,.48);display:flex;align-items:flex-end;justify-content:center;padding:12px;box-sizing:border-box}.BWBTactilePanel{width:min(620px,100%);max-height:82vh;overflow:auto;background:#f5f6f7;border-radius:18px 18px 12px 12px;padding:16px;box-sizing:border-box;box-shadow:0 -8px 30px rgba(0,0,0,.22)}.BWBTactilePanelHeader{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px}.BWBTactilePanelHeader strong{font-size:20px}.BWBTactileClose{width:48px;height:48px;border:0;border-radius:50%;background:#dfe2e7;font-size:25px;color:#111}.BWBTactileOptions{display:grid;grid-template-columns:1fr;gap:9px}.BWBTactileOption{width:100%;min-height:56px;padding:12px 16px;border:1px solid #c8cdd5;border-radius:12px;background:#fff;color:#080d45;font-family:inherit;font-size:17px;font-weight:600;line-height:1.35;text-align:left}.BWBTactileOption.Selected{border:2px solid #11158f;background:#eef0ff}.BWBTactileOption.Selected:after{content:'✓';float:right;color:#087f3f;font-size:21px}.BWBWorkSheet select.BWBNativeSelectHidden{position:absolute!important;width:1px!important;height:1px!important;min-height:1px!important;overflow:hidden!important;clip:rect(0 0 0 0)!important;clip-path:inset(50%)!important;white-space:nowrap!important}
}
</style>
<div class="BWBWorkSheet">
 <div class="SheetHeader"><h1>Folha de trabalho</h1><div class="HeaderTicket">Ticket#[% Data.TicketNumber | html %]</div><div class="HeaderCustomer">[% Data.CustomerID | html %][% IF Data.CustomerName && Data.CustomerName != Data.CustomerID %] | [% Data.CustomerName | html %][% END %]</div><div class="HeaderCustomerUser">[% Data.CustomerUserName | html %]</div><div class="HeaderTitle">[% Data.TicketTitle | html %]</div></div>
 <div class="WorkCard">
  [% IF Data.Error %]<div class="ErrorBox">[% Data.Error | html %]</div>[% END %]
  <form method="post" action="[% Env("CGIHandle") %]" id="BWBWorkForm" enctype="multipart/form-data">
   <input type="hidden" name="Action" value="AgentBWBWorkSession"><input type="hidden" name="TicketID" value="[% Data.TicketID | html %]"><input type="hidden" name="ChallengeToken" value="[% Env("ChallengeToken") | html %]"><input type="hidden" name="FormID" value="[% Data.FormID | html %]">
   [% IF !Data.Active %]
    <input type="hidden" name="Subaction" value="Start">
    <label for="WorkType">Tipo de intervenção</label><div><select name="WorkType" id="WorkType" class="Modernize W75pc" required><option value="">— Selecionar —</option>[% FOREACH Type IN Data.WorkTypes %]<option value="[% Type.Name | html %]">[% Type.Name | html %]</option>[% END %]</select></div>
    <div class="Actions"><button class="CallForAction Primary" type="submit"><span>Iniciar trabalho</span></button></div>
   [% ELSE %]
    <div class="ProtectedText WorkSummary"><div class="WorkSummaryItem"><span class="WorkSummaryLabel">Assistência técnica iniciada em:</span><span class="WorkSummaryValue">[% Data.StartTime | html %]</span></div><div class="WorkSummaryItem"><span class="WorkSummaryLabel">Tipo de intervenção:</span><span class="WorkSummaryValue">[% Data.WorkType | html %]</span></div><div class="WorkSummaryItem"><span class="WorkSummaryLabel">Técnico:</span><span class="WorkSummaryValue">[% Data.TechnicianName | html %]</span></div></div>
    [% IF Data.Paused %]<div class="Paused"><strong>Trabalho em pausa.</strong> O tempo de pausa não será contabilizado.</div>[% END %]
    <label for="RichText">Notas do trabalho</label>
    <div class="RichTextField"><textarea id="RichText" name="Body" rows="16">[% Data.Body | html %]</textarea><div class="BWBEditor"><div class="BWBEditorToolbar" role="toolbar" aria-label="Formatação das notas"><button type="button" data-command="bold" title="Negrito"><strong>B</strong></button><button type="button" data-command="italic" title="Itálico"><em>I</em></button><button type="button" data-command="insertUnorderedList" title="Lista com marcas">&#8226;☰</button><button type="button" data-command="insertOrderedList" title="Lista numerada">1.☰</button></div><div id="BWBEditorBody" class="BWBEditorBody" contenteditable="true" role="textbox" aria-multiline="true">[% Data.Body %]</div></div></div>
    <label>Anexos</label><div class="Field">[% INCLUDE "FormElements/AttachmentList.tt" FormID=Data.FormID %]</div><div class="Clear"></div>
    <div class="SaveStatus" id="BWBSaveStatus">Rascunho guardado</div>
    <div class="FinishFields">
     <div><label for="Result">Resultado</label><select name="Result" id="Result" class="Modernize" required><option value="">— Selecionar —</option>[% FOREACH Item IN Data.Results %]<option value="[% Item.Name | html %]">[% Item.Name | html %]</option>[% END %]</select></div>
     <div id="OwnerChoice" style="display:none"><label for="NewOwnerID">Novo proprietário</label><select name="NewOwnerID" id="NewOwnerID"><option value="">— Selecionar —</option>[% FOREACH Owner IN Data.Owners %]<option value="[% Owner.UserID | html %]">[% Owner.UserFullname | html %]</option>[% END %]</select></div>
     <div id="DecisionChoice" style="display:none"><label for="Decision">Decisão</label><select name="Decision" id="Decision"><option value="pending">Aguardar confirmação do cliente</option><option value="close">Fechar com êxito</option></select></div>
     <div id="PendingChoice" style="display:none"><label for="PendingDate">Retomar em</label><input type="datetime-local" name="PendingDate" id="PendingDate"></div>
     <div id="StateChoice" style="display:none"><label for="State">Estado seguinte</label><select name="State" id="State"><option value="open">Aberto</option><option value="Pendente a aguardar cliente">Pendente a aguardar cliente</option><option value="Pendente até determinada data">Pendente até determinada data</option><option value="Aguardar fornecedor">Aguardar fornecedor</option><option value="encerrado com êxito">Encerrado com êxito</option><option value="encerrado sem êxito">Encerrado sem êxito</option></select></div>
     <div class="VisibilityChoice"><strong>Visível no portal do cliente?</strong><br><label><input type="radio" name="Visibility" value="yes" required> Sim</label><label><input type="radio" name="Visibility" value="no" required> Não</label></div>
     <div class="VisibilityChoice"><strong>Enviar por e-mail ao cliente?</strong><br><label><input type="radio" name="SendEmail" value="yes"> Sim</label><label><input type="radio" name="SendEmail" value="no" checked> Não</label></div>
    </div>
    <div class="Actions">
     <button type="button" class="CallForAction CancelAction" id="BWBCancel"><span>CANCELAR</span></button>
     [% IF Data.Paused %]<button type="button" class="CallForAction PauseAction" id="BWBResume"><span>Retomar trabalho</span></button>[% ELSE %]<button type="button" class="CallForAction PauseAction" id="BWBPause"><span>Colocar em pausa</span></button>[% END %]
     <button type="submit" class="CallForAction FinishAction" id="BWBFinish"><span>Terminar trabalho</span></button>
    </div>
   [% END %]
  </form>
 </div>
</div>
<script>
(function(){
var Touch=window.matchMedia('(hover: none) and (pointer: coarse)').matches||window.matchMedia('(max-width: 1024px)').matches;
if(!Touch)return;
document.querySelectorAll('.BWBWorkSheet select').forEach(function(S){
 if(S.dataset.bwbTouchReady)return;S.dataset.bwbTouchReady='1';
 var L=document.querySelector('label[for="'+S.id+'"]'),Title=L?L.textContent.trim():'Selecionar opção';
 var Trigger=document.createElement('button');Trigger.type='button';Trigger.className='BWBTactileSelect';
 function refresh(){var O=S.options[S.selectedIndex];Trigger.textContent=O&&O.value?O.textContent:'— Selecionar —';Trigger.classList.toggle('Placeholder',!O||!O.value);}
 refresh();S.classList.add('BWBNativeSelectHidden');S.insertAdjacentElement('afterend',Trigger);
 Trigger.addEventListener('click',function(){
  var Overlay=document.createElement('div');Overlay.className='BWBTactileOverlay';Overlay.setAttribute('role','dialog');Overlay.setAttribute('aria-modal','true');Overlay.setAttribute('aria-label',Title);
  var Panel=document.createElement('div');Panel.className='BWBTactilePanel';
  var Head=document.createElement('div');Head.className='BWBTactilePanelHeader';var H=document.createElement('strong');H.textContent=Title;var Close=document.createElement('button');Close.type='button';Close.className='BWBTactileClose';Close.setAttribute('aria-label','Fechar');Close.textContent='×';Head.append(H,Close);
  var Options=document.createElement('div');Options.className='BWBTactileOptions';
  Array.from(S.options).forEach(function(O){if(!O.value)return;var B=document.createElement('button');B.type='button';B.className='BWBTactileOption'+(O.selected?' Selected':'');B.textContent=O.textContent;B.onclick=function(){S.value=O.value;S.dispatchEvent(new Event('change',{bubbles:true}));refresh();Overlay.remove();Trigger.focus();};Options.appendChild(B);});
  Panel.append(Head,Options);Overlay.appendChild(Panel);document.body.appendChild(Overlay);Close.onclick=function(){Overlay.remove();Trigger.focus();};Overlay.onclick=function(E){if(E.target===Overlay){Overlay.remove();Trigger.focus();}};
  setTimeout(function(){var First=Options.querySelector('.Selected')||Options.querySelector('button');if(First)First.focus();},0);
 });
 });
})();
</script>
[% IF Data.Active %]
<script>
(function(){var F=document.getElementById('BWBWorkForm'),T=document.getElementById('RichText'),E=document.getElementById('BWBEditorBody'),Timer,Finishing=false;
function sync(){T.value=E.innerHTML;}
function save(){sync();var D=new FormData(F);D.set('Subaction','SaveDraft');document.getElementById('BWBSaveStatus').textContent='A guardar…';fetch(F.action,{method:'POST',body:D,credentials:'same-origin'}).then(function(){document.getElementById('BWBSaveStatus').textContent='Rascunho guardado';});}
function later(){clearTimeout(Timer);Timer=setTimeout(save,1200);} E.addEventListener('input',later);document.querySelectorAll('.BWBEditorToolbar button').forEach(function(B){B.addEventListener('click',function(){E.focus();document.execCommand(B.dataset.command,false,null);sync();later();});});setInterval(function(){if(!Finishing)save();},30000);
function action(Name){sync();var D=new FormData(F);D.set('Subaction',Name);fetch(F.action,{method:'POST',body:D,credentials:'same-origin'}).then(function(){location.reload();});}
var P=document.getElementById('BWBPause'),R=document.getElementById('BWBResume'),C=document.getElementById('BWBCancel');if(P)P.onclick=function(){action('Pause');};if(R)R.onclick=function(){action('Resume');};
if(C)C.onclick=function(){if(!window.confirm('Pretende cancelar esta folha de trabalho? O rascunho, os anexos temporários e o tempo registado serão eliminados. O ticket não será alterado.'))return;Finishing=true;sync();var S=document.createElement('input');S.type='hidden';S.name='Subaction';S.value='Cancel';F.appendChild(S);F.submit();};
F.addEventListener('submit',function(E){if(E.submitter&&E.submitter.id==='BWBFinish'){Finishing=true;sync();var S=document.createElement('input');S.type='hidden';S.name='Subaction';S.value='Finish';F.appendChild(S);}});
document.getElementById('Result').addEventListener('change',function(){var V=this.value;document.getElementById('OwnerChoice').style.display=V==='Encaminhado para outro técnico'?'block':'none';document.getElementById('DecisionChoice').style.display=V==='Sem anomalia detetada'?'block':'none';document.getElementById('PendingChoice').style.display=V==='A aguardar intervenção presencial'?'block':'none';document.getElementById('StateChoice').style.display=V==='Outro'?'block':'none';});
window.addEventListener('beforeunload',function(){if(!Finishing)save();});
})();
</script>
[% END %]

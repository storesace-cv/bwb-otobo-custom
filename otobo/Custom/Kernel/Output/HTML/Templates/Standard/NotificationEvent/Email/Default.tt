<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <style type="text/css">
    body {
        width: 100% !important;
        -webkit-text-size-adjust: none;
        margin: 0px;
        padding: 0px;
    }

    #templateContainer, #templateBody, #templateFooter {
        width: 100% !important;
        max-width: 680px !important;
    }

    .brandLogo {
        display: block;
        width: auto;
        max-width: 128px;
        height: 44px;
    }

    @media only screen and (max-width: 700px) {
        #backgroundTable { width: 100% !important; }
        #templateContainer { width: 100% !important; border-left: 0 !important; border-right: 0 !important; }
        .emailHeader { padding: 16px !important; }
        .emailSubject { font-size: 18px !important; line-height: 1.3 !important; }
        .bodyContent { padding: 16px !important; font-size: 14px !important; }
        .brandLogo { height: 38px !important; max-width: 112px !important; }
    }

    table td {
        border-collapse: collapse;
    }

    #backgroundTable {
        height: 100% !important;
        margin: 0;
        padding: 0;
        width: 100% !important;
    }

    h1, h2, h3, h4, h5, h6 {
        color:#1d1d1f;
        display:block;
        font-family:Arial;
        font-weight:bold;
        line-height:100%;
        margin-top:0;
        margin-right:0;
        margin-bottom:5px;
        margin-left:0;
        text-align:left;
    }

    h1 {
        font-size: 34px;
    }

    h2, h3, h4, h5, h6 {
        margin-top: 5px;
        margin-bottom: 5px;
    }

        h2 {
            font-size: 28px;
        }

        h3 {
            font-size: 24px;
        }

        h4 {
            font-size: 22px;
        }

        h5 {
            font-size: 18px;
        }

        h6 {
            font-size: 16px;
        }

        #templateContainer, .bodyContent{
            background-color: #FFFFFF;
        }

        .bodyContent, .bodyContent * {
            color: #000000;
            font-family: Arial;
            font-size: 13px;
            line-height: 150%;
            text-align: left;
        }

        .bodyContent div {
            padding-bottom: 5px;
        }

        .bodyContent a:link,
        .bodyContent a:visited,
        .footerContent div a:link,
        .footerContent div a:visited {
            color: #3a3a3c;
            font-weight: normal;
            text-decoration: none
        }

        #templateFooter {
            background-color: #FFFFFF;
            border-top: 0px;
        }

        .footerContent div {
            color:#707070;
            font-family:Arial;
            font-size:13px;
            line-height:125%;
            text-align:left;
        }

        #links {
            background-color: #FAFAFA;
            border: 0;
        }

        #links div {
            text-align: center;
        }

        .CallForAction:active,
        .CallForAction:hover {
            background-color: #e5e5e5;
            border-color: #999;
        }

        .bodyContent a {
            color: #3a3a3c !important;
        }

        .im {
            color: #555 !important;
        }
        </style>
    </head>
    <body leftmargin="0" marginwidth="0" topmargin="0" marginheight="0" offset="0">
        <center>
            <table border="0" cellpadding="0" cellspacing="0" height="100%" width="100%" id="backgroundTable" style="background-color:#f5f5f7;">
                <tbody>
                    <tr>
                        <td align="center" valign="top">
                            <br />
                            <table border="0" cellpadding="0" cellspacing="0" width="680" id="templateContainer" style="width:100%; max-width:680px; border:1px solid #DDDDDD;">
                                <tbody>
                                    <tr>
                                        <td align="center" valign="top">
                                            <table border="0" cellpadding="0" cellspacing="0" id="templateBody">
                                                <tbody>
                                                    <tr>
                                                        <td valign="middle" class="emailHeader" height="84" style="height:84px; background:#e5e5e7; padding:0 20px; text-align:left;">
                                                            <img class="brandLogo" src="https://helpdesk.bwb.pt/otobo-web/common/img/bwb-black-compact.svg" width="126" height="44" alt="BWB" style="display:block; width:auto; max-width:126px; height:44px; border:0; margin:0;">
                                                        </td>
                                                    </tr>
                                                    <tr><td height="84" style="height:84px; background:#ffffff; font-size:1px; line-height:1px;">&nbsp;</td></tr>
                                                    <tr>
                                                        <td valign="middle" class="emailHeader" style="background:[% Data.StateBackgroundColor | html %]; padding:22px 20px; text-align:left;">
                                                            <h1 class="emailSubject" style="padding:0; line-height:130%; color:[% Data.StateTextColor | html %]; margin:0; font-size:20px; text-align:left;">[% Data.Subject | html %]</h1>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td valign="top" class="bodyContent" style="border-bottom: 1px solid #eee; background-color: #fff; padding: 15px; font-size: 13px;">
                                                            [% Data.Body
                                                            .replace('<p>', '<div>')
                                                            .replace('</p>', '</div>')
                                                            .replace('<div\s+type="cite"[^>]*>', '<div type="cite" style="background: #f5f5f5; border: 0px !important; color: #555; margin: 10px 0px 0px 0px; padding: 10px;">')
                                                            .replace('border:none;border-left:solid\s+blue\s+1.5pt;padding:0cm\s+0cm\s+0cm\s+4.0pt', 'border: none; border-left: 1px solid #8e8e93 !important; color: #3a3a3c; margin: 10px 5px 10px 0px; padding: 0px 10px;')
                                                            %]
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td align="center" valign="top">
                                            <table border="0" cellpadding="10" cellspacing="0" id="templateFooter">
                                                <tbody>
                                                    <tr>
                                                        <td valign="top" class="footerContent">
                                                        [% IF !Config("Secure::DisableBanner") %]
                                                            <table border="0" cellpadding="10" cellspacing="0" width="100%">
                                                                <tbody>
                                                                    <tr>
                                                                        <td colspan="2" valign="middle">
                                                                            <div style="color: #999; font-size: 11px; text-align: center;">
                                                                                <a href="https://bwb.pt/" target="_blank" style="color:#666666; text-decoration:none;">Powered by BwB | © 2026 | jorge peixinho</a>
                                                                            </div>
                                                                        </td>
                                                                    </tr>
                                                                </tbody>
                                                            </table>
                                                        [% END %]
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <br />
                        </td>
                    </tr>
                </tbody>
            </table>
        </center>
    </body>

    </html>

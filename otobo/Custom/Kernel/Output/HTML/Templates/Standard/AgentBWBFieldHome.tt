<div class="BWBFieldHome">
[% IF Data.View == 'tickets' %]
  <header class="BWBFieldSectionHead">
    <a class="BWBFieldBack" href="[% Env("Baselink") %]Action=AgentBWBFieldHome">← Painel</a>
    <h1>Folhas de trabalho</h1>
    <p class="BWBFieldMuted">Tickets abertos em seu nome. Ao escolher, abre a folha de trabalho.</p>
  </header>
  [% IF Data.Tickets.size %]
  <ul class="BWBFieldList">
    [% FOREACH T IN Data.Tickets %]
    <li>
      <a class="BWBFieldListItem" href="[% Env("Baselink") %]Action=AgentBWBWorkSession;TicketID=[% T.TicketID | html %]">
        <strong>Ticket#[% T.TicketNumber | html %]</strong>
        <span class="BWBFieldMuted">[% T.Customer | html %]</span>
        <span class="BWBFieldMuted">[% T.Store | html %]</span>
        <span>[% T.Title | html %]</span>
        <span class="BWBFieldMuted">[% T.State | html %]</span>
      </a>
    </li>
    [% END %]
  </ul>
  [% ELSE %]
  <p class="BWBFieldEmpty">Não tem tickets abertos em seu nome.</p>
  [% END %]

[% ELSIF Data.View == 'create' %]
  <header class="BWBFieldSectionHead">
    <a class="BWBFieldBack" href="[% Env("Baselink") %]Action=AgentBWBFieldHome">← Painel</a>
    <h1>Novo ticket</h1>
    <p class="BWBFieldMuted">Crie o ticket e abra de seguida a folha de trabalho.</p>
  </header>
  [% IF Data.Error %]<div class="BWBFieldError" role="alert">[% Data.Error | html %]</div>[% END %]
  [% IF !Data.Customers.size %]
  <p class="BWBFieldEmpty">Não tem clientes atribuídos. Peça ao responsável para lhe associar clientes ou lojas.</p>
  [% ELSE %]
  <form class="BWBFieldForm" method="post" action="[% Env("CGIHandle") %]" id="BWBFieldTicketForm">
    <input type="hidden" name="Action" value="AgentBWBFieldHome">
    <input type="hidden" name="Subaction" value="StoreTicket">
    <input type="hidden" name="ChallengeToken" value="[% Env("ChallengeToken") | html %]">
    <label for="CustomerID">Cliente</label>
    <select name="CustomerID" id="CustomerID" required>
      <option value="">— Selecionar —</option>
      [% FOREACH C IN Data.Customers %]
      <option value="[% C.CustomerID | html %]">[% C.Label | html %]</option>
      [% END %]
    </select>
    <label for="CustomerUser">Utilizador de cliente</label>
    <select name="CustomerUser" id="CustomerUser" required disabled>
      <option value="">— Selecionar cliente primeiro —</option>
      [% FOREACH U IN Data.CustomerUsers %]
      <option value="[% U.Login | html %]" data-customer-id="[% U.CustomerID | html %]" hidden disabled>[% U.Label | html %]</option>
      [% END %]
    </select>
    <label for="Title">Título</label>
    <input type="text" name="Title" id="Title" required maxlength="200" autocomplete="off">
    <label for="Body">Problema</label>
    <textarea name="Body" id="Body" rows="8" required></textarea>
    <label for="PriorityID">Prioridade</label>
    <select name="PriorityID" id="PriorityID" required>
      [% FOREACH P IN Data.Priorities %]
      <option value="[% P.PriorityID | html %]"[% IF P.Selected %] selected[% END %]>[% P.Name | html %]</option>
      [% END %]
    </select>
    <div class="BWBFieldActions">
      <button type="submit" class="BWBFieldPrimary">Gravar e abrir folha</button>
    </div>
  </form>
  [% END %]

[% ELSE %]
  <header class="BWBFieldSectionHead">
    <h1>Painel de Controlo</h1>
    <p class="BWBFieldMuted">Modo de campo</p>
  </header>

  <section class="BWBFieldZone" aria-labelledby="BWBFieldOpsTitle">
    <h2 id="BWBFieldOpsTitle">Zona operacional</h2>
    <p class="BWBFieldMuted">Pode iniciar:</p>
    <div class="BWBFieldOps">
      <a class="BWBFieldOpCard" href="[% Env("Baselink") %]Action=AgentBWBFieldHome;Subaction=StartWork">
        <strong>Folhas de trabalho</strong>
        <span>Escolher um ticket aberto em seu nome e abrir a folha.</span>
      </a>
      <a class="BWBFieldOpCard" href="[% Env("Baselink") %]Action=AgentBWBFieldHome;Subaction=NewTicket">
        <strong>Tickets</strong>
        <span>Criar ticket do cliente e abrir a folha de imediato.</span>
      </a>
    </div>
  </section>

  <section class="BWBFieldZone" aria-labelledby="BWBFieldInfoTitle">
    <h2 id="BWBFieldInfoTitle">Dashboard informativo</h2>

    <h3>Tickets abertos</h3>
    [% IF Data.OpenTickets.size %]
    <ul class="BWBFieldList">
      [% FOREACH T IN Data.OpenTickets %]
      <li>
        <a class="BWBFieldListItem" href="[% Env("Baselink") %]Action=AgentBWBWorkSession;TicketID=[% T.TicketID | html %]">
          <strong>Ticket#[% T.TicketNumber | html %]</strong>
          <span class="BWBFieldMuted">[% T.Customer | html %]</span>
          <span class="BWBFieldMuted">[% T.Store | html %]</span>
          <span>[% T.Title | html %]</span>
        </a>
      </li>
      [% END %]
    </ul>
    [% ELSE %]
    <p class="BWBFieldEmpty">Sem tickets abertos em seu nome.</p>
    [% END %]

    <h3>Folhas de trabalho abertas</h3>
    [% IF Data.OpenWork.size %]
    <ul class="BWBFieldList">
      [% FOREACH W IN Data.OpenWork %]
      <li>
        <a class="BWBFieldListItem" href="[% Env("Baselink") %]Action=AgentBWBWorkSession;TicketID=[% W.TicketID | html %]">
          <strong>Ticket#[% W.TicketNumber | html %]</strong>
          <span class="BWBFieldMuted">[% W.Customer | html %]</span>
          <span class="BWBFieldMuted">[% W.Store | html %]</span>
          <span class="[% W.StatusClass | html %]">[% W.Status | html %]</span>
          <span>[% W.Title | html %]</span>
          <span class="BWBFieldMuted">[% W.WorkType | html %]</span>
        </a>
      </li>
      [% END %]
    </ul>
    [% ELSE %]
    <p class="BWBFieldEmpty">Sem folhas em execução ou em pausa.</p>
    [% END %]
  </section>
[% END %]
</div>
[%# Tactile selects + customer cascade are handled by Core.Agent.BWBFieldMode.js %]

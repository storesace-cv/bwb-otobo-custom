<div id='oooFooter' class='BWBFooter'>
    <div>
        <div id='oooCopyright'>
            <a class="BWBFooterBrand" href="https://bwb.pt/" title="BWB" target="_blank" rel="noopener noreferrer">
                <span class="BWBFooterLogoBox"><img class="BWBFooterLogo" src="/otobo-web/common/img/bwb-white-compact.svg" alt="BWB"></span>
                <span class="BWBFooterText">Powered by BwB | © 2026 | jorge peixinho</span>
            </a>
        </div>
        <div id='FooterLinks'>
[% IF(Data.FooterLinks) %]
    [% FOREACH Link IN Data.FooterLinks %]
            <a href="[% Link.Target | html %]" target="_blank" class="ooo10g">[% Link.Description | Translate | html %]</a>
    [% END %]
[% END %]
        </div>
    </div>
</div>
<style>
    #oooFooter.BWBFooter #oooCopyright { display:flex; align-items:center; justify-content:center; }
    #oooFooter.BWBFooter .BWBFooterBrand { display:inline-flex; align-items:center; justify-content:center; gap:8px; max-width:100%; color:inherit; text-decoration:none; }
    #oooFooter.BWBFooter .BWBFooterLogoBox { display:inline-flex; align-items:center; justify-content:center; box-sizing:border-box; padding:3px 8px; border-radius:4px; background:#00003b; }
    #oooFooter.BWBFooter .BWBFooterLogo { display:block; width:auto; height:18px; max-width:90px; object-fit:contain; }
    #oooFooter.BWBFooter .BWBFooterText { white-space:nowrap; }
    @media (max-width:600px) {
        #oooFooter.BWBFooter .BWBFooterBrand { gap:5px; font-size:10px; }
        #oooFooter.BWBFooter .BWBFooterLogoBox { padding:2px 6px; }
        #oooFooter.BWBFooter .BWBFooterLogo { height:15px; max-width:76px; }
        #oooFooter.BWBFooter .BWBFooterText { white-space:normal; text-align:left; }
    }
</style>

[% InsertTemplate("CustomerFooterJS.tt") %]

</body>
</html>

<div id="Footer" class="ARIARoleContentinfo BWBFooter">
    <a class="BWBFooterBrand" href="https://bwb.pt/" title="BWB" target="_blank" rel="noopener noreferrer">
        <span class="BWBFooterLogoBox"><img class="BWBFooterLogo" src="/otobo-web/common/img/bwb-white-compact.svg" alt="BWB"></span>
        <span class="BWBFooterText">Powered by BwB | © 2026 | jorge peixinho</span>
    </a>
</div>
<style>
    body:not(.LoginScreen):has(.MainBox) {
        background-color:#17130f;
        background-image:linear-gradient(rgba(0,0,0,.38), rgba(0,0,0,.48)), url('/otobo-web/common/img/otobo-peacock-agent.jpg');
        background-position:center center;
        background-repeat:no-repeat;
        background-size:cover;
        background-attachment:fixed;
    }
    body:not(.LoginScreen):has(.MainBox) #AppWrapper,
    body:not(.LoginScreen):has(.MainBox) #Footer.BWBFooter { background:transparent; }
    body:not(.LoginScreen):has(.MainBox) #Footer.BWBFooter { margin-top:0; color:#fff; text-shadow:0 1px 3px rgba(0,0,0,.9); }
    #Footer.BWBFooter .BWBFooterBrand { display:inline-flex; align-items:center; justify-content:center; gap:8px; max-width:100%; color:inherit; text-decoration:none; }
    body:not(.LoginScreen):has(.MainBox) #Footer.BWBFooter .BWBFooterBrand { color:#fff; }
    #Footer.BWBFooter .BWBFooterLogoBox { display:inline-flex; align-items:center; justify-content:center; box-sizing:border-box; width:auto; height:auto; padding:3px 8px; border-radius:4px; background:#00003b; }
    #Footer.BWBFooter .BWBFooterLogo { display:block; width:auto; height:18px; max-width:90px; object-fit:contain; }
    #Footer.BWBFooter .BWBFooterText { width:auto; height:auto; background:none; white-space:nowrap; }
    @media (max-width:600px) {
        #Footer.BWBFooter .BWBFooterBrand { gap:5px; font-size:10px; }
        #Footer.BWBFooter .BWBFooterLogoBox { padding:2px 6px; }
        #Footer.BWBFooter .BWBFooterLogo { height:15px; max-width:76px; }
        #Footer.BWBFooter .BWBFooterText { white-space:normal; text-align:left; }
    }
</style>

[% InsertTemplate("FooterJS.tt") %]

    </div><!-- end AppWrapper -->

</body>
</html>

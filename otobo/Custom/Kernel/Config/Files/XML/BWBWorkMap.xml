<?xml version="1.0" encoding="utf-8"?>
<otobo_config version="2.0" init="Application">
    <Setting Name="BWB::MapsEmbedAPIKey" Required="0" Valid="1">
        <Description Translatable="1">Chave Google Maps Embed API (só iframe no AgentTicketZoom). Nunca versionar o valor. Restringir a Sites + Maps Embed API no Google Cloud.</Description>
        <Navigation>BWB::Core</Navigation>
        <Value>
            <Item ValueType="Password" ValueRegex=""></Item>
        </Value>
    </Setting>
    <Setting Name="Frontend::Module###AgentBWBWorkMap" Required="0" Valid="1">
        <Description Translatable="1">JSON das coordenadas de fecho das folhas de trabalho (mapa Google Embed no zoom).</Description>
        <Navigation>Frontend::Agent::ModuleRegistration</Navigation>
        <Value>
            <Hash>
                <Item Key="Group"><Array/></Item>
                <Item Key="GroupRo"><Array/></Item>
                <Item Key="Description" Translatable="1">Mapa da localização da folha</Item>
                <Item Key="Title" Translatable="1">Mapa da folha</Item>
                <Item Key="NavBarName"></Item>
            </Hash>
        </Value>
    </Setting>
    <Setting Name="Frontend::Output::FilterElementPost###BWBWorkMapEmbedKey" Required="0" Valid="1">
        <Description Translatable="1">Injeta a chave Maps Embed no Core.Config do AgentTicketZoom.</Description>
        <Navigation>Frontend::Base::OutputFilter</Navigation>
        <Value>
            <Hash>
                <Item Key="Module">Kernel::Output::HTML::FilterElementPost::BWBWorkMapEmbedKey</Item>
                <Item Key="Templates">
                    <Hash>
                        <Item Key="AgentTicketZoom">1</Item>
                    </Hash>
                </Item>
            </Hash>
        </Value>
    </Setting>
    <Setting Name="Loader::Agent::CommonJS###964-BWBWorkMap" Required="0" Valid="1">
        <Description Translatable="1">Mapa Google Embed da localização no fecho da folha (AgentTicketZoom).</Description>
        <Navigation>Frontend::Base::Loader</Navigation>
        <Value>
            <Array>
                <Item>Core.Agent.BWBWorkMap.js</Item>
            </Array>
        </Value>
    </Setting>
    <Setting Name="Loader::Agent::CommonCSS###964-BWBWorkMap" Required="0" Valid="1">
        <Description Translatable="1">Estilos do contentor do mapa da folha de trabalho.</Description>
        <Navigation>Frontend::Base::Loader</Navigation>
        <Value>
            <Array>
                <Item>BWBWorkMap.css</Item>
            </Array>
        </Value>
    </Setting>
</otobo_config>

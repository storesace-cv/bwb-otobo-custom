<?xml version="1.0" encoding="utf-8"?>
<otobo_config version="2.0" init="Application">
    <Setting Name="Ticket::EventModulePost###6900-BWBTicketStore" Required="0" Valid="1">
        <Description Translatable="1">Copia a loja do utilizador de cliente para o ticket na criação ou ao associar cliente, se o ticket ainda não tiver loja.</Description>
        <Navigation>Core::Event::Ticket</Navigation>
        <Value>
            <Hash>
                <Item Key="Module">Kernel::System::Ticket::Event::BWBTicketStore</Item>
                <Item Key="Event">(TicketCreate|TicketCustomerUpdate)</Item>
            </Hash>
        </Value>
    </Setting>
    <Setting Name="Frontend::Module###AgentBWBTicketStore" Required="0" Valid="1">
        <Description Translatable="1">Alterar a loja persistida no ticket sem mudar a ficha do utilizador de cliente.</Description>
        <Navigation>Frontend::Agent::ModuleRegistration</Navigation>
        <Value>
            <Hash>
                <Item Key="Group"><Array/></Item>
                <Item Key="GroupRo"><Array/></Item>
                <Item Key="Description">Alterar loja do ticket</Item>
                <Item Key="Title">Alterar loja</Item>
                <Item Key="NavBarName">Ticket</Item>
            </Hash>
        </Value>
    </Setting>
    <Setting Name="Ticket::Frontend::MenuModule###426-BWBTicketStore" Required="0" Valid="1">
        <Description Translatable="1">Mostra a acção para alterar a loja do ticket.</Description>
        <Navigation>Frontend::Agent::View::TicketZoom::MenuModule</Navigation>
        <Value>
            <Hash>
                <Item Key="Module">Kernel::Output::HTML::TicketMenu::BWBTicketStore</Item>
                <Item Key="Name">Alterar loja</Item>
                <Item Key="Description">Alterar a loja deste ticket</Item>
                <Item Key="Action">AgentBWBTicketStore</Item>
                <Item Key="Link">Action=AgentBWBTicketStore;TicketID=[% Data.TicketID | html %]</Item>
                <Item Key="Target"></Item>
                <Item Key="PopupType"></Item>
                <Item Key="ClusterName">Miscellaneous</Item>
                <Item Key="ClusterPriority">1</Item>
            </Hash>
        </Value>
    </Setting>
    <Setting Name="Loader::Agent::CommonJS###963-BWBTicketStoreDialog" Required="0" Valid="1">
        <Description Translatable="1">Diálogo nativo para alterar a loja do ticket.</Description>
        <Navigation>Frontend::Base::Loader</Navigation>
        <Value>
            <Array>
                <Item>Core.Agent.BWBTicketStoreDialog.js</Item>
            </Array>
        </Value>
    </Setting>
</otobo_config>
